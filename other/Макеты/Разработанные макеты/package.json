{
  "name": "espada-theme",
  "version": "1.0.0",
  "private": true,
  "description": "Тема WordPress для СК «Эспада». Сборка SCSS + JS.",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
