   "texts": [
    {
     "role": "zero",
     "tag": "div",
     "text": "ПРИСОЕДИНЯЙСЯ К НАШЕЙ ДРУЖНОЙ КОМАНДЕ В КАЧЕСТВЕ ПАРТНЕРА!"
    },
    {
     "role": "zero",
     "tag": "div",
     "text": "Высокая конверсия лидов"
    },
    {
     "role": "zero",
     "tag": "div",
     "text": "— грамотная обработка заявок;"
    },
    {
     "role": "zero",
     "tag": "div",
     "text": "— профессиональные замеры и консультации;"
    },
    {
     "role": "zero",
     "tag": "div",
     "text": "— умение работать с возражениями клиентов."
    },
    {
     "role": "zero",
     "tag": "div",
     "text": "Высокий средний чек"
    },
    {
     "role": "zero",
     "tag": "div",
     "text": "— полный цикл работ по ремонту;"
    },
    {
     "role": "zero",
     "tag": "div",
     "text": "— дополнительные услуги (дизайн-проекты, спецмонтаж и т.д.)."
    },
    {
     "role": "zero",
     "tag": "div",
     "text": "Предсказуемость и контроль результата"
    },
    {
     "role": "zero",
     "tag": "div",
     "text": "— чёткая фиксация каждого лида;"
    },
    {
     "role": "zero",
     "tag": "div",
     "text": "— понятный статус на всех этапах сделки;"
    },
    {
     "role": "zero",
     "tag": "div",
     "text": "Долгосрочное сотрудничество"
    },
    {
     "role": "zero",
     "tag": "div",
     "text": "— мы заинтересованы не в разовой сделке, а в партнёрстве;"
    },
    {
     "role": "zero",
     "tag": "div",
     "text": "— готовы масштабировать взаимодействие при росте объёмов."
    }
