# ─── Кэш выгрузок и промежуточные данные семантики ───────────────────────────
# Пересобираются скриптами из репозитория, в истории не нужны.
# Дорогие результаты запросов к API (частотность, коммерциализация) оставлены:
# без них пересборка таблиц снова потратит лимиты.

other/Семантика и структура/материалы/арсенкин/
other/Семантика и структура/материалы/ядро_сырое.json
other/Семантика и структура/материалы/ядро_коммерч.json
other/Семантика и структура/материалы/ядро_инфо.json
other/Семантика и структура/материалы/ядро_профиль.json
other/Семантика и структура/материалы/ядро_инфо_профиль.json
other/Семантика и структура/материалы/ядро_на_разбор.json
other/Семантика и структура/материалы/лог_*.txt

# ─── Секреты окружения ───────────────────────────────────────────────────────
# Реальные конфиги не коммитим, только примеры с плейсхолдерами.
*.env
!*.env.example
site/env/*.env
!site/env/*.env.example
wp-config.php
auth.json

# ─── WordPress: чужой код и пользовательские загрузки ────────────────────────
# Ядро и сторонние плагины ставятся composer/wp-cli, аплоады живут на сервере.
site/wp-content/uploads/
site/wp-content/upgrade/
site/wp-content/cache/
site/wp/
site/wordpress/
vendor/
node_modules/

# ─── Дампы базы ──────────────────────────────────────────────────────────────
*.sql
*.sql.gz
*.sql.zip
backups/

# ─── Временные файлы систем и офиса ──────────────────────────────────────────
Thumbs.db
desktop.ini
.DS_Store
~$*
*.tmp
*.bak
.idea/
.vscode/
__pycache__/
*.pyc
